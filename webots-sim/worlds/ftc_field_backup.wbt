Robot {
  translation 0 0.08 0
  rotation 1 0 0 1.5708
  children [
    DEF BODY Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.2 0.8
        roughness 0.5
        metalness 0
      }
      geometry Box {
        size 0.457 0.15 0.457
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis -1 0 0
        anchor -0.24 -0.035 0
      }
      device [
        RotationalMotor {
          name "left_drive"
          maxVelocity 20
        }
        PositionSensor {
          name "left_drive_sensor"
        }
      ]
      endPoint Solid {
        translation -0.24 -0.035 0
        children [
          Transform {
            rotation 0 1 0 1.5708
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 0.1 0.1 0.1
                  roughness 0.8
                  metalness 0
                }
                geometry Cylinder {
                  height 0.03
                  radius 0.05
                }
              }
            ]
          }
        ]
        name "left_wheel"
        boundingObject Transform {
          rotation 0 1 0 1.5708
          children [
            Cylinder {
              height 0.03
              radius 0.05
            }
          ]
        }
        physics Physics {
          density -1
          mass 0.05
        }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 1 0 0
        anchor 0.24 -0.035 0
      }
      device [
        RotationalMotor {
          name "right_drive"
