              height 0.03
              radius 0.05
            }
          ]
        }
        physics Physics {
          density -1
          mass 0.05
        }
      }
    }
    Solid {
      translation 0 -0.055 -0.2
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.5 0.5 0.5
            roughness 0.3
            metalness 0.5
          }
          geometry Sphere {
            radius 0.02
          }
        }
      ]
      name "caster"
      contactMaterial "caster"
